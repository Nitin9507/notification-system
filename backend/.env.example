# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL is required — there is no SQLite fallback.
# Create the local database once:
#   sudo -u postgres psql -c "CREATE USER notif_user WITH PASSWORD 'notif_pass';"
#   sudo -u postgres psql -c "CREATE DATABASE notification_system OWNER notif_user;"
#   sudo -u postgres psql -c "ALTER USER notif_user CREATEDB;"   # for the test DB
# On Render, paste the Postgres "Internal Database URL" instead.
DATABASE_URL=postgres://notif_user:notif_pass@localhost:5432/notification_system

# Where the frontend lives — used as the click-through URL on web push.
FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Shared secret for POST /api/internal/run-scheduled-triggers/
INTERNAL_CRON_SECRET=change-me

# ---------------------------------------------------------------------------
# WhatsApp — Meta Cloud API sandbox
# developers.facebook.com -> your app -> WhatsApp -> API Setup
# The test token expires roughly every 24h; regenerate it when sends fail.
# ---------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Any string you choose; paste the same one into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=verify-me

# ---------------------------------------------------------------------------
# Email — "brevo" (300/day free) or "postmark" (~100/month free)
# The sender address must be verified with whichever provider you pick.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# POSTMARK_TOKEN=
DEFAULT_FROM_EMAIL=you@example.com
DEFAULT_FROM_NAME=Notification System

# ---------------------------------------------------------------------------
# Web Push — OneSignal (browser only)
# ---------------------------------------------------------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Apps created today use include_subscription_ids; older ones include_player_ids.
ONESIGNAL_TARGET_FIELD=include_subscription_ids

# Meta app secret, used to verify inbound webhook signatures.
# App dashboard -> Settings -> Basic -> App Secret. Leave blank locally.
WHATSAPP_APP_SECRET=
